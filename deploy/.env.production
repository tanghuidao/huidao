# ===== huidao.cc 生产环境配置 =====

# ---- Database (PostgreSQL) ----
POSTGRES_USER=huidao
POSTGRES_PASSWORD=请替换为强密码_至少16位
POSTGRES_DB=monitor
DATABASE_URL=postgresql://huidao:请替换为强密码_至少16位@db:5432/monitor

# ---- LLM (OpenAI API) ----
# 获取: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-你的API密钥
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Scheduler ----
SCHEDULER_ENABLED=true
SCHEDULER_COLLECT_INTERVAL=60

# ---- Email Notification ----
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_HOST=smtp.gmail.com
NOTIFY_EMAIL_PORT=587
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASS=
NOTIFY_EMAIL_TO=

# ---- Webhook (飞书/Slack/Discord) ----
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=

# ---- Telegram ----
NOTIFY_TELEGRAM_ENABLED=false
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ---- Domain ----
DOMAIN=huidao.cc
EMAIL=你的邮箱@example.com
